# The public edge: the only container on the host's own network, so the address it sees is the
# client's own and the firewall's audit log names the right address to ban.
[Unit]
Description=Nashville public safety panel edge proxy
After=network-online.target panel-api.service panel-dashboard.service
Wants=network-online.target

[Container]
Image=localhost/panel-caddy:latest
Network=host
User=10003:10003
NoNewPrivileges=true
DropCapability=ALL
# Ports 80 and 443 are privileged; nothing else here is.
AddCapability=NET_BIND_SERVICE
ReadOnly=true
Tmpfs=/tmp
# Certificates have to outlive the container; the audit log is read by fail2ban on the host.
Volume=panel-certificates.volume:/var/lib/caddy:z
Volume=/var/log/caddy:/var/log/caddy:z
Environment=PANEL_SITE_ADDRESS=localhost
Environment=PANEL_API_UPSTREAM=127.0.0.1:8001
Environment=PANEL_DASHBOARD_UPSTREAM=127.0.0.1:8080
HealthCmd=caddy version
HealthInterval=60s
HealthTimeout=5s
HealthRetries=3

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
