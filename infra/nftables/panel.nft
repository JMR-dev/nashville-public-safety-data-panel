#!/usr/sbin/nft -f
# The host firewall. nftables owns filtering on this host: the Ansible role disables and masks
# firewalld first, because two services writing rules is how a host ends up open by accident.

flush ruleset

# Where administrators connect from. The Ansible role writes this file from the deployment's
# own inventory; infra/nftables/panel-management.example.nft shows what it looks like.
include "/etc/nftables/panel-management.nft"

table inet panel {
	set management {
		type ipv4_addr
		flags interval
		elements = $management_v4
	}

	set management6 {
		type ipv6_addr
		flags interval
		elements = $management_v6
	}

	chain input {
		type filter hook input priority filter; policy drop;

		ct state established,related accept
		ct state invalid drop
		iif lo accept

		# Enough ICMP for diagnostics and for path MTU discovery to keep working.
		ip protocol icmp icmp type { echo-request, destination-unreachable, time-exceeded, parameter-problem } accept
		ip6 nexthdr icmpv6 icmpv6 type { echo-request, destination-unreachable, packet-too-big, time-exceeded, parameter-problem, nd-neighbor-solicit, nd-neighbor-advert, nd-router-solicit, nd-router-advert } accept

		# The dashboard, the API, and the event stream, all of them through Caddy.
		tcp dport { 80, 443 } accept

		# Administration comes from known addresses only.
		ip saddr @management tcp dport 22 accept
		ip6 saddr @management6 tcp dport 22 accept

		counter comment "refused by policy"
	}

	chain forward {
		type filter hook forward priority filter; policy drop;

		ct state established,related accept
		ct state invalid drop
		# The worker reaches Metro Nashville's service from its container network.
		iifname "podman*" accept
	}

	chain output {
		type filter hook output priority filter; policy accept;
	}
}
